# =====================================================
# FORMAT RUPIAH
# =====================================================


def rupiah(angka):
    return f"Rp{angka:,.2f}".replace(",", ".")


# =====================================================
# BUNGA SEDERHANA
# =====================================================


def bunga_sederhana(P, i, t):

    bunga = P * i * t
    total = P + bunga

    print("\n===== BUNGA SEDERHANA =====")

    print(f"Pokok            = {rupiah(P)}")
    print(f"Bunga            = {i*100:.2f}%")
    print(f"Waktu            = {t} tahun")
    print(f"Bunga diperoleh  = {rupiah(bunga)}")
    print(f"Jumlah akhir     = {rupiah(total)}")


# =====================================================
# BUNGA MAJEMUK
# =====================================================


def bunga_majemuk(P, i, n):

    total = P * (1 + i) ** n

    print("\n===== BUNGA MAJEMUK =====")

    print(f"Pokok            = {rupiah(P)}")
    print(f"Bunga            = {i*100:.2f}%")
    print(f"Periode          = {n}")
    print(f"Jumlah akhir     = {rupiah(total)}")


# =====================================================
# COMPOUND m-KALI SETAHUN
# =====================================================


def compound_m(P, nominal, m, t):

    total = P * (1 + nominal / m) ** (m * t)

    print("\n===== COMPOUND m-KALI SETAHUN =====")

    print(f"Pokok                = {rupiah(P)}")
    print(f"Bunga nominal        = {nominal*100:.2f}%")
    print(f"Frekuensi m          = {m}")
    print(f"Waktu                = {t} tahun")
    print(f"Jumlah akhir         = {rupiah(total)}")


# =====================================================
# BUNGA EFEKTIF
# =====================================================


def bunga_efektif(nominal, m):

    efektif = (1 + nominal / m) ** m - 1

    print("\n===== BUNGA EFEKTIF =====")

    print(f"Bunga nominal        = {nominal*100:.2f}%")
    print(f"Frekuensi            = {m}")
    print(f"Bunga efektif        = {efektif*100:.4f}%")


# =====================================================
# PRESENT VALUE
# =====================================================


def present_value(FV, i, n):

    PV = FV / (1 + i) ** n

    print("\n===== PRESENT VALUE =====")

    print(f"Future Value         = {rupiah(FV)}")
    print(f"Bunga                = {i*100:.2f}%")
    print(f"Periode              = {n}")
    print(f"Present Value        = {rupiah(PV)}")


# =====================================================
# FUTURE VALUE
# =====================================================


def future_value(PV, i, n):

    FV = PV * (1 + i) ** n

    print("\n===== FUTURE VALUE =====")

    print(f"Present Value        = {rupiah(PV)}")
    print(f"Bunga                = {i*100:.2f}%")
    print(f"Periode              = {n}")
    print(f"Future Value         = {rupiah(FV)}")


# =====================================================
# DISKONTO SEDERHANA
# =====================================================


def diskonto_sederhana(FV, d, t):

    PV = FV * (1 - d * t)

    print("\n===== DISKONTO SEDERHANA =====")

    print(f"Future Value         = {rupiah(FV)}")
    print(f"Diskonto             = {d*100:.2f}%")
    print(f"Waktu                = {t}")
    print(f"Present Value        = {rupiah(PV)}")


# =====================================================
# DISKONTO MAJEMUK
# =====================================================


def diskonto_majemuk(FV, d, n):

    PV = FV * (1 - d) ** n

    print("\n===== DISKONTO MAJEMUK =====")

    print(f"Future Value         = {rupiah(FV)}")
    print(f"Diskonto             = {d*100:.2f}%")
    print(f"Periode              = {n}")
    print(f"Present Value        = {rupiah(PV)}")


# =====================================================
# FORCE OF INTEREST
# =====================================================


def force_interest(P, delta, t):

    total = P * math.exp(delta * t)

    print("\n===== FORCE OF INTEREST =====")

    print(f"Pokok                = {rupiah(P)}")
    print(f"Delta                = {delta*100:.2f}%")
    print(f"Waktu                = {t}")
    print(f"Jumlah akhir         = {rupiah(total)}")


# =====================================================
# KONVERSI i, d, v
# =====================================================


def konversi_bunga(i=None, d=None, v=None):

    print("\n===== KONVERSI BUNGA =====")

    if i is not None:

        d = i / (1 + i)
        v = 1 / (1 + i)

        print(f"i = {i*100:.2f}%")
        print(f"d = {d*100:.2f}%")
        print(f"v = {v:.4f}")

    elif d is not None:

        i = d / (1 - d)
        v = 1 - d

        print(f"d = {d*100:.2f}%")
        print(f"i = {i*100:.2f}%")
        print(f"v = {v:.4f}")

    elif v is not None:

        i = (1 / v) - 1
        d = 1 - v

        print(f"v = {v:.4f}")
        print(f"i = {i*100:.2f}%")
        print(f"d = {d*100:.2f}%")


# =====================================================
# PERSAMAAN NILAI
# =====================================================


def equation_of_value(cashflows, i, focal):

    total = 0

    print("\n===== PERSAMAAN NILAI =====")

    for nilai, waktu in cashflows:

        nilai_fokus = nilai * (1 + i) ** (focal - waktu)

        total += nilai_fokus

        print(
            f"Cashflow {rupiah(nilai)} pada t={waktu} -> {rupiah(nilai_fokus)}"
        )

    print(f"\nTotal pada tanggal fokus t={focal} = {rupiah(total)}")


# =====================================================
# NPV
# =====================================================


def npv(cashflows, i):

    total = 0

    print("\n===== NET PRESENT VALUE =====")

    for nilai, t in cashflows:

        pv = nilai / (1 + i) ** t

        total += pv

        print(
            f"Cashflow {rupiah(nilai)} di t={t} -> PV = {rupiah(pv)}"
        )

    print(f"\nNPV = {rupiah(total)}")

    if total > 0:
        print("Keputusan: INVESTASI MENGUNTUNGKAN")
    else:
        print("Keputusan: INVESTASI TIDAK MENGUNTUNGKAN")


# =====================================================
# ANUITAS
# =====================================================


def annuity_immediate_pv(R, i, n):

    PV = R * ((1 - (1 + i) ** (-n)) / i)

    print("\n===== ANUITAS IMMEDIATE PV =====")
    print(f"Nilai sekarang = {rupiah(PV)}")



def annuity_immediate_fv(R, i, n):

    FV = R * (((1 + i) ** n - 1) / i)

    print("\n===== ANUITAS IMMEDIATE FV =====")
    print(f"Nilai akumulasi = {rupiah(FV)}")



def annuity_due_pv(R, i, n):

    PV = R * ((1 - (1 + i) ** (-n)) / i) * (1 + i)

    print("\n===== ANUITAS DUE PV =====")
    print(f"Nilai sekarang = {rupiah(PV)}")



def annuity_due_fv(R, i, n):

    FV = R * ((((1 + i) ** n) - 1) / i) * (1 + i)

    print("\n===== ANUITAS DUE FV =====")
    print(f"Nilai akumulasi = {rupiah(FV)}")


# =====================================================
# AMORTISASI
# =====================================================


def amortisasi(pinjaman, i, n):

    a = (1 - (1 + i) ** (-n)) / i
    angsuran = pinjaman / a

    saldo = pinjaman

    print("\n===== TABEL AMORTISASI =====")

    print(
        f"{'Periode':<10}{'Angsuran':<20}{'Bunga':<20}{'Pokok':<20}{'Sisa':<20}"
    )

    for periode in range(1, n + 1):

        bunga = saldo * i
        pokok = angsuran - bunga
        saldo -= pokok

        if saldo < 1:
            saldo = 0

        print(
            f"{periode:<10}{rupiah(angsuran):<20}{rupiah(bunga):<20}{rupiah(pokok):<20}{rupiah(saldo):<20}"
        )


# =====================================================
# CARI JUMLAH PERIODE
# =====================================================


def cari_periode(PV, R, i):

    nilai = 1 - (PV * i / R)

    n = -math.log(nilai) / math.log(1 + i)

    print("\n===== JUMLAH PERIODE =====")

    print(f"Jumlah periode = {n:.2f}")


# =====================================================
# IRR
# =====================================================


def irr_sederhana(cashflows):

    print("\n===== IRR =====")

    best_i = None
    best_npv = float("inf")

    for persen in range(1, 101):

        i = persen / 100

        total = 0

        for nilai, t in cashflows:
            total += nilai / ((1 + i) ** t)

        if abs(total) < best_npv:
            best_npv = abs(total)
            best_i = i

    print(f"IRR kira-kira = {best_i*100:.2f}%")


# =====================================================
# HITUNG HARI
# =====================================================


def hitung_hari(tgl_awal, tgl_akhir):

    format_tanggal = "%d-%m-%Y"

    awal = datetime.strptime(tgl_awal, format_tanggal)
    akhir = datetime.strptime(tgl_akhir, format_tanggal)

    selisih = (akhir - awal).days

    print("\n===== PERHITUNGAN HARI =====")

    print(f"Jumlah hari = {selisih} hari")


